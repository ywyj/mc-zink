-/* TODO: implement disk cache support on windows */
+#include "util/u_atomic.h"
+
+/* [dsh-mesaopt] Windows implementation of the on-disk shader cache.
+ *
+ * Upstream Mesa only implements this layer for POSIX; the Windows branch is an
+ * empty TODO stub, which is why meson.build forbids -Dshader-cache=enabled on
+ * Windows.  The implementation in disk_cache_os.c uses plain Win32 file APIs
+ * and keeps the generic logic (cache keys, compression, async put queue) from
+ * disk_cache.c unchanged.
+ *
+ * Layout: <base>/<driver_id>/<key[0:2]>/<key-hex>.bin
+ *   <base> = MESA_SHADER_CACHE_DIR (or MESA_GLSL_CACHE_DIR) if set,
+ *            else %LOCALAPPDATA%/mesa_shader_cache
+ * Each entry is struct cache_entry_file_data followed by the (optionally
+ * deflate-compressed) payload.
+ *
+ * The key index and the total cache size are kept in memory instead of in an
+ * mmapped "index" file: LRU eviction runs a directory scan for the oldest file,
+ * which is cheap at the few-thousand-file scale of a shader cache.
+ */
+
+/* Number of bits to mask off from a cache key to get an index. */
+#define CACHE_INDEX_KEY_BITS 16
+
+/* Mask for computing an index from a key. */
+#define CACHE_INDEX_KEY_MASK ((1 << CACHE_INDEX_KEY_BITS) - 1)
+
+/* The number of keys that can be stored in the index. */
+#define CACHE_INDEX_MAX_KEYS (1 << CACHE_INDEX_KEY_BITS)
+
+enum disk_cache_type {
+   DISK_CACHE_NONE,
+   DISK_CACHE_MULTI_FILE,
+   DISK_CACHE_SINGLE_FILE,
+   DISK_CACHE_DATABASE,
+};
+
+struct disk_cache {
+   /* The path to the cache directory. */
+   char *path;
+   bool path_init_failed;
+
+   /* Thread queue for compressing and writing cache entries to disk */
+   struct util_queue cache_queue;
+
+   enum disk_cache_type type;
+
+   /* Seed for rand, which is used to pick a random directory */
+   uint64_t seed_xorshift128plus[2];
+
+   /* In-memory index bookkeeping (no file mapping on Windows). */
+   uint8_t *index_mmap;
+   uint8_t *index_reserve;
+   size_t index_reserve_size;
+
+   /* Pointer to total size of all objects in cache */
+   p_atomic_uint64_t *size;
+
+   /* Stored keys, CACHE_INDEX_MAX_KEYS entries of CACHE_KEY_SIZE bytes. */
+   uint8_t *stored_keys;
+
+   /* Whether the in-memory size bookkeeping matches the directory contents. */
+   bool size_is_valid;
+
+   /* Maximum size of all cached objects (in bytes). */
+   uint64_t max_size;
+
+   /* Driver cache keys. */
+   uint8_t *driver_keys_blob;
+   size_t driver_keys_blob_size;
+
+   disk_cache_put_cb blob_put_cb;
+   disk_cache_get_cb blob_get_cb;
+
+   /* Don't compress cached data. This is for testing purposes only. */
+   bool compression_disabled;
+
+   struct {
+      bool enabled;
+      unsigned hits;
+      unsigned misses;
+   } stats;
+
+   /* Unused on Windows (single-file/FOZ and database caches are unsupported). */
+   struct disk_cache *foz_ro_cache;
+};
+
+struct cache_entry_file_data {
+   uint32_t crc32;
+   uint32_t uncompressed_size;
+};
+
+struct disk_cache_put_job {
+   struct util_queue_fence fence;
+
+   struct disk_cache *cache;
+
+   cache_key key;
+
+   /* Copy of cache data to be compressed and written. */
+   void *data;
+
+   /* Size of data to be compressed and written. */
+   size_t size;
+
+   struct cache_item_metadata cache_item_metadata;
+};
+
+const char *
+disk_cache_generate_cache_dir(void *mem_ctx, const char *gpu_name,
+                              const char *driver_id,
+                              const char *cache_dir_name_custom,
+                              enum disk_cache_type cache_type,
+                              bool mkdir);
+
+bool
+disk_cache_evict_lru_item(struct disk_cache *cache);
+
+bool
+disk_cache_size_is_valid(struct disk_cache *cache);
+
+void
+disk_cache_recompute_size(struct disk_cache *cache);
+
+void
+disk_cache_evict_item(struct disk_cache *cache, char *filename);
+
+void *
+disk_cache_load_item_foz(struct disk_cache *cache, const cache_key key,
+                         size_t *size);
+
+void *
+disk_cache_load_item(struct disk_cache *cache, char *filename, size_t *size);
+
+char *
+disk_cache_get_cache_filename(struct disk_cache *cache, const cache_key key);
+
+bool
+disk_cache_write_item_to_disk_foz(struct disk_cache_put_job *dc_job);
+
+void
+disk_cache_write_item_to_disk(struct disk_cache_put_job *dc_job,
+                              char *filename);
+
+bool
+disk_cache_enabled(void);
+
+bool
+disk_cache_load_cache_index_foz(void *mem_ctx, struct disk_cache *cache);
+
+void
+disk_cache_touch_cache_user_marker(char *path);
+
+bool
+disk_cache_mmap_cache_index(void *mem_ctx, struct disk_cache *cache);
+
+void
+disk_cache_destroy_mmap(struct disk_cache *cache);
+
+void *
+disk_cache_db_load_item(struct disk_cache *cache, const cache_key key,
+                        size_t *size);
+
+bool
+disk_cache_db_write_item_to_disk(struct disk_cache_put_job *dc_job);
+
+bool
+disk_cache_db_load_cache_index(void *mem_ctx, struct disk_cache *cache);
+
+void
+disk_cache_delete_old_cache(void);
 
 #else
 

