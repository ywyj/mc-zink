+/* ---------------------------- TTL eviction ------------------------------ */
+/* [dsh-mesaopt] Age-based eviction for the Win32 multi-file backend.
+ * A cache hit refreshes the file's last-write time below, so this is an
+ * access-based policy: entries that have not been *used* for N days are
+ * deleted.  MESA_SHADER_CACHE_TTL_DAYS=0 disables it; default 30 days.
+ */
+#define DISK_CACHE_DEFAULT_TTL_DAYS 30
+
+static unsigned
+disk_cache_ttl_days(void)
+{
+   const char *s = getenv("MESA_SHADER_CACHE_TTL_DAYS");
+
+   if (s && *s) {
+      char *end;
+      unsigned long v = strtoul(s, &end, 10);
+
+      if (end != s)
+         return (unsigned)v;
+   }
+   return DISK_CACHE_DEFAULT_TTL_DAYS;
+}
+
+static void
+disk_cache_touch_file_last_write(const char *filename)
+{
+   wchar_t *w = utf8_to_wide(filename);
+   HANDLE h;
+
+   if (!w)
+      return;
+   h = CreateFileW(w, FILE_WRITE_ATTRIBUTES,
+                   FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                   NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+   free(w);
+   if (h != INVALID_HANDLE_VALUE) {
+      FILETIME now;
+
+      GetSystemTimeAsFileTime(&now);
+      SetFileTime(h, NULL, NULL, &now);
+      CloseHandle(h);
+   }
+}
+
+static uint64_t
+sweep_expired_dir(const wchar_t *dir, const FILETIME *cutoff)
+{
+   wchar_t *pattern;
+   WIN32_FIND_DATAW fd;
+   HANDLE h;
+   uint64_t freed = 0;
+
+   pattern = malloc((wcslen(dir) + 3) * sizeof(wchar_t));
+   if (!pattern)
+      return 0;
+   wcscpy(pattern, dir);
+   wcscat(pattern, L"/*");
+   h = FindFirstFileW(pattern, &fd);
+   free(pattern);
+   if (h == INVALID_HANDLE_VALUE)
+      return 0;
+
+   do {
+      size_t len;
+      wchar_t *full;
+
+      if (wcscmp(fd.cFileName, L".") == 0 || wcscmp(fd.cFileName, L"..") == 0)
+         continue;
+      len = wcslen(dir) + wcslen(fd.cFileName) + 2;
+      full = malloc(len * sizeof(wchar_t));
+      if (!full)
+         continue;
+      swprintf(full, len, L"%ls/%ls", dir, fd.cFileName);
+      if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) {
+         freed += sweep_expired_dir(full, cutoff);
+      } else if (CompareFileTime(&fd.ftLastWriteTime, cutoff) < 0) {
+         if (DeleteFileW(full))
+            freed += ((uint64_t)fd.nFileSizeHigh << 32) | fd.nFileSizeLow;
+      }
+      free(full);
+   } while (FindNextFileW(h, &fd));
+   FindClose(h);
+   return freed;
+}
+
+uint64_t
+disk_cache_sweep_expired(struct disk_cache *cache)
+{
+   unsigned days = disk_cache_ttl_days();
+   FILETIME now_ft, cutoff;
+   ULARGE_INTEGER now, age, cut;
+   wchar_t *dir;
+   uint64_t freed;
+
+   if (!days || !cache || !cache->path || cache->path_init_failed)
+      return 0;
+
+   age.QuadPart = (uint64_t)days * 86400ULL * 10000000ULL;
+   GetSystemTimeAsFileTime(&now_ft);
+   now.LowPart = now_ft.dwLowDateTime;
+   now.HighPart = now_ft.dwHighDateTime;
+   cut.QuadPart = now.QuadPart > age.QuadPart ? now.QuadPart - age.QuadPart : 0;
+   cutoff.dwLowDateTime = cut.LowPart;
+   cutoff.dwHighDateTime = cut.HighPart;
+
+   dir = utf8_to_wide(cache->path);
+   if (!dir)
+      return 0;
+   freed = sweep_expired_dir(dir, &cutoff);
+   free(dir);
+
+   if (freed)
+      cache_size_sub(cache, freed);
+   return freed;
 }
 
