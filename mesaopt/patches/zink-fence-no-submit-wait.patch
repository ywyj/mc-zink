diff --git a/src/gallium/drivers/zink/zink_fence.c b/src/gallium/drivers/zink/zink_fence.c
--- a/src/gallium/drivers/zink/zink_fence.c
+++ b/src/gallium/drivers/zink/zink_fence.c
@@ -135,7 +135,9 @@
    if (fence->completed)
       return true;
 
-   if (screen->threaded_submit) {
+   /* [dsh-mesaopt ZOO6] env-gated: the fence is already submitted (assert below), so
+    * waiting for the submit thread before the timeline wait is redundant. Default off. */
+   if (screen->threaded_submit && !screen->fence_no_submit_wait) {
       int64_t abs_timeout = os_time_get_absolute_timeout(timeout_ns);
       if (!util_queue_fence_wait_timeout(&bs->flush_completed, abs_timeout))
          return false;
