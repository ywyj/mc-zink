+/*
+ * [dsh-mesaopt ZOO] Runtime switches for the patch-zoo diagnostic DLL
+ * (artifact: dist/zoo1/opengl32.zoo1.dll).
+ *
+ * Every switch defaults to the original upstream behavior, so a run with no
+ * MESA_ZINK_* env set behaves exactly like the z0v1 diagnostic build.  Each
+ * switch is read exactly ONCE (zink_zoo_init() during screen creation) into a
+ * plain global; the hot paths only test a predictable global boolean/int.
+ *
+ * Env vars:
+ *   MESA_ZINK_SYNC_PRESENT=1      P1: force synchronous present
+ *                                 (cdt->async = false; zink_kopper.c)
+ *   MESA_ZINK_NO_ASYNC_PRESENT=1  P4: alias of P1 (same upstream mechanism:
+ *                                 cdt->async gates both async acquire waiting
+ *                                 and queuing of the present job, so a separate
+ *                                 "no async present only" toggle would leave
+ *                                 present_fence unsignalled and deadlock the
+ *                                 acquire path).  Kept as a second name for
+ *                                 A/B bookkeeping only.
+ *   MESA_ZINK_NO_FB_WAIT=1        P3: drop the per-frame
+ *                                 util_queue_fence_wait(&bs->flush_completed)
+ *                                 in zink_flush_frontbuffer (upstream 33f0fecc)
+ *   MESA_ZINK_BATCH_WINDOW=N      P2: in-flight batch count above which
+ *                                 post_submit throttles (upstream 5; valid
+ *                                 2..1024, invalid values keep 5)
+ *
+ * P5 (u_threaded_context generic CPU optimizations: upstream 32658eec,
+ * 5710cae1, 1ca365b2) is intentionally NOT compiled in: it is a pure
+ * optimization without a behavior switch.  Tracked as zoo_v2 candidate in
+ * notes/ZOO1.md.
+ */
+#ifndef ZINK_ZOO_H
+#define ZINK_ZOO_H
+
+#include <stdbool.h>
+
+/* P1 (+ P4 alias): synchronous present (original code keeps cdt->async). */
+extern bool zink_zoo_sync_present;
+
+/* P3: skip the per-frame flush_completed wait before presenting. */
+extern bool zink_zoo_no_fb_wait;
+
+/* P2: in-flight batch count threshold; default 5 = original behavior. */
+extern unsigned zink_zoo_batch_window;
+
+void zink_zoo_init(void);
+
+#endif /* ZINK_ZOO_H */
