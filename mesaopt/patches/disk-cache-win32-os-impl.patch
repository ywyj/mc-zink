+
+/* [dsh-mesaopt] Win32 disk cache backend (upstream only had a TODO stub here).
+ * Layout: <base>/<driver_id>/<key[0:2]>/<key-hex>.bin
+ *   <base> = MESA_SHADER_CACHE_DIR (or MESA_GLSL_CACHE_DIR), else
+ *            %LOCALAPPDATA%/mesa_shader_cache
+ * Entry = struct cache_entry_file_data + payload (deflate-compressed unless the
+ * driver disables compression).  Index and total size are kept in memory; LRU
+ * eviction does a directory scan for the oldest file.  Every failure path is a
+ * cache miss, never a crash.
+ */
+
+#include <windows.h>
+#include <wchar.h>
+
+#include "util/compress.h"
+#include "util/crc32.h"
+#include "util/os_misc.h"
+#include "util/ralloc.h"
+#include "util/u_atomic.h"
+#include "util/u_debug.h"
+
+/* ------------------------------- helpers -------------------------------- */
+
+static char *
+dup_str(const char *s)
+{
+   size_t n = strlen(s) + 1;
+   char *r = malloc(n);
+
+   if (r)
+      memcpy(r, s, n);
+   return r;
+}
+
+static wchar_t *
+utf8_to_wide(const char *s)
+{
+   int n;
+   wchar_t *w;
+
+   if (!s)
+      return NULL;
+
+   n = MultiByteToWideChar(CP_UTF8, 0, s, -1, NULL, 0);
+   if (n <= 0)
+      return NULL;
+
+   w = malloc(sizeof(wchar_t) * (size_t)n);
+   if (!w)
+      return NULL;
+
+   if (MultiByteToWideChar(CP_UTF8, 0, s, -1, w, n) <= 0) {
+      free(w);
+      return NULL;
+   }
+   return w;
+}
+
+static char *
+wide_to_utf8(const wchar_t *w)
+{
+   int n;
+   char *s;
+
+   if (!w)
+      return NULL;
+
+   n = WideCharToMultiByte(CP_UTF8, 0, w, -1, NULL, 0, NULL, NULL);
+   if (n <= 0)
+      return NULL;
+
+   s = malloc((size_t)n);
+   if (!s)
+      return NULL;
+
+   if (WideCharToMultiByte(CP_UTF8, 0, w, -1, s, n, NULL, NULL) <= 0) {
+      free(s);
+      return NULL;
+   }
+   return s;
+}
+
+static char *
+path_join(const char *a, const char *b)
+{
+   size_t la, lb;
+   bool sep;
+   char *r;
+
+   if (!a || !b)
+      return NULL;
+
+   la = strlen(a);
+   lb = strlen(b);
+   sep = la > 0 && a[la - 1] != '/' && a[la - 1] != '\\';
+
+   r = malloc(la + (sep ? 1 : 0) + lb + 1);
+   if (!r)
+      return NULL;
+
+   memcpy(r, a, la);
+   if (sep)
+      r[la++] = '/';
+   memcpy(r + la, b, lb);
+   r[la + lb] = '\0';
+   return r;
+}
+
+static bool
+mkdir_one(const wchar_t *path)
+{
+   if (CreateDirectoryW(path, NULL))
+      return true;
+   return GetLastError() == ERROR_ALREADY_EXISTS;
+}
+
+static bool
+mkdir_recursive(const char *path_utf8)
+{
+   wchar_t *w = utf8_to_wide(path_utf8);
+   wchar_t *p;
+   bool ok = true;
+
+   if (!w)
+      return false;
+
+   for (p = w; *p; p++) {
+      wchar_t save;
+      size_t len;
+      bool is_root;
+
+      if (*p != L'/' && *p != L'\\')
+         continue;
+
+      save = *p;
+      *p = 0;
+      len = wcslen(w);
+      is_root = len <= 2 && w[1] == L':';   /* "C:" / "C:/" always exists */
+      if (len > 0 && !is_root && !mkdir_one(w))
+         ok = false;
+      *p = save;
+   }
+
+   if (ok && !mkdir_one(w))
+      ok = false;
+
+   free(w);
+   return ok;
+}
+
+static char *
+sanitize_component(const char *s)
+{
+   size_t n, i;
+   char *r;
+
+   if (!s || !s[0])
+      return NULL;
+
+   n = strlen(s);
+   r = malloc(n + 1);
+   if (!r)
+      return NULL;
+
+   for (i = 0; i < n; i++) {
+      unsigned char c = (unsigned char)s[i];
+      if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+          (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.')
+         r[i] = (char)c;
+      else
+         r[i] = '_';
+   }
+   r[n] = '\0';
+   return r;
+}
+
+static char *
+get_localappdata_utf8(void)
+{
+   return wide_to_utf8(_wgetenv(L"LOCALAPPDATA"));
+}
+
+static void
+key_to_hex(const cache_key key, char *out)
+{
+   static const char hex[] = "0123456789abcdef";
+   unsigned i;
+
+   for (i = 0; i < CACHE_KEY_SIZE; i++) {
+      out[i * 2] = hex[key[i] >> 4];
+      out[i * 2 + 1] = hex[key[i] & 0xf];
+   }
+   out[CACHE_KEY_SIZE * 2] = '\0';
+}
+
+/* ---------------------------- configuration ----------------------------- */
+
+bool
+disk_cache_enabled(void)
+{
+   const char *mode = os_get_option("MESA_SHADER_CACHE_MODE");
+
+   if (mode && strcmp(mode, "disabled") == 0)
+      return false;
+
+   return !debug_get_bool_option("MESA_SHADER_CACHE_DISABLE", false);
+}
+
+const char *
+disk_cache_generate_cache_dir(void *mem_ctx, const char *gpu_name,
+                              const char *driver_id,
+                              const char *cache_dir_name_custom,
+                              enum disk_cache_type cache_type, bool mkdir)
+{
+   const char *dir_opt = os_get_option("MESA_SHADER_CACHE_DIR");
+   char *base = NULL, *sub, *path;
+   const char *ret;
+
+   (void)gpu_name;
+   (void)cache_type;
+
+   if (!dir_opt)
+      dir_opt = os_get_option("MESA_GLSL_CACHE_DIR");
+
+   if (dir_opt && dir_opt[0]) {
+      base = dup_str(dir_opt);
+   } else {
+      char *lad = get_localappdata_utf8();
+
+      if (lad) {
+         base = path_join(lad, CACHE_DIR_NAME);
+         free(lad);
+      }
+      if (!base) {
+         const char *tmp = getenv("TEMP");
+         base = path_join(tmp && tmp[0] ? tmp : ".", CACHE_DIR_NAME);
+      }
+   }
+   if (!base)
+      return NULL;
+
+   sub = sanitize_component(cache_dir_name_custom ? cache_dir_name_custom
+                                                  : driver_id);
+   path = sub ? path_join(base, sub) : NULL;
+   free(base);
+   free(sub);
+   if (!path)
+      return NULL;
+
+   if (mkdir && !mkdir_recursive(path)) {
+      free(path);
+      return NULL;
+   }
+
+   ret = ralloc_strdup(mem_ctx, path);
+   free(path);
+   return ret;
+}
