+bool
+disk_cache_mmap_cache_index(void *mem_ctx, struct disk_cache *cache)
+{
+   (void)mem_ctx;
+
+   if (!cache->path)
+      return false;
+
+   cache->stored_keys = calloc(CACHE_INDEX_MAX_KEYS, CACHE_KEY_SIZE);
+   cache->size = calloc(1, sizeof(*cache->size));
+   if (!cache->stored_keys || !cache->size) {
+      free(cache->stored_keys);
+      free(cache->size);
+      cache->stored_keys = NULL;
+      cache->size = NULL;
+      return false;
+   }
+
+   p_atomic_set(&cache->size->value, 0);
+   cache->size_is_valid = false;
+   return true;
+}
+
+void
+disk_cache_destroy_mmap(struct disk_cache *cache)
+{
+   free(cache->stored_keys);
+   cache->stored_keys = NULL;
+   free(cache->size);
+   cache->size = NULL;
+}
+
+bool
+disk_cache_size_is_valid(struct disk_cache *cache)
+{
+   return cache->size_is_valid;
+}
+
+/* ---------------------------- directory scans --------------------------- */
+
+struct cache_scan {
+   uint64_t total_size;
+   bool want_lru;
+   bool have_lru;
+   FILETIME lru_time;
+   char *lru_file;
+};
+
+static void
+scan_dir(const wchar_t *dir, struct cache_scan *scan)
+{
+   wchar_t *pattern;
+   WIN32_FIND_DATAW fd;
+   HANDLE h;
+
+   pattern = malloc((wcslen(dir) + 3) * sizeof(wchar_t));
+   if (!pattern)
+      return;
+
+   wcscpy(pattern, dir);
+   wcscat(pattern, L"/*");
+
+   h = FindFirstFileW(pattern, &fd);
+   free(pattern);
+   if (h == INVALID_HANDLE_VALUE)
+      return;
+
+   do {
+      size_t len;
+      wchar_t *full;
+
+      if (wcscmp(fd.cFileName, L".") == 0 || wcscmp(fd.cFileName, L"..") == 0)
+         continue;
+
+      len = wcslen(dir) + wcslen(fd.cFileName) + 2;
+      full = malloc(len * sizeof(wchar_t));
+      if (!full)
+         continue;
+      swprintf(full, len, L"%ls/%ls", dir, fd.cFileName);
+
+      if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) {
+         scan_dir(full, scan);
+      } else {
+         uint64_t fsize = ((uint64_t)fd.nFileSizeHigh << 32) | fd.nFileSizeLow;
+
+         scan->total_size += fsize;
+
+         if (scan->want_lru &&
+             (!scan->have_lru ||
+              CompareFileTime(&fd.ftLastWriteTime, &scan->lru_time) < 0)) {
+            char *u8 = wide_to_utf8(full);
+
+            if (u8) {
+               free(scan->lru_file);
+               scan->lru_file = u8;
+               scan->lru_time = fd.ftLastWriteTime;
+               scan->have_lru = true;
+            }
+         }
+      }
+
+      free(full);
+   } while (FindNextFileW(h, &fd));
+
+   FindClose(h);
+}
+
+static void
+cache_size_sub(struct disk_cache *cache, uint64_t n)
+{
+   uint64_t cur;
+
+   if (!cache->size || !n)
+      return;
+
+   cur = p_atomic_read(&cache->size->value);
+   for (;;) {
+      uint64_t next = cur > n ? cur - n : 0;
+      uint64_t prev = p_atomic_cmpxchg(&cache->size->value, cur, next);
+
+      if (prev == cur)
+         return;
+      cur = prev;
+   }
+}
+
+void
+disk_cache_recompute_size(struct disk_cache *cache)
+{
+   struct cache_scan scan;
+   wchar_t *wpath;
+
+   if (!cache->path || !cache->size)
+      return;
+
+   memset(&scan, 0, sizeof(scan));
+
+   wpath = utf8_to_wide(cache->path);
+   if (wpath) {
+      scan_dir(wpath, &scan);
+      free(wpath);
+   }
+
+   p_atomic_set(&cache->size->value, scan.total_size);
+   cache->size_is_valid = true;
+}
+
+void
+disk_cache_evict_item(struct disk_cache *cache, char *filename)
+{
+   wchar_t *w;
+   WIN32_FILE_ATTRIBUTE_DATA ad;
+   uint64_t fsize = 0;
+   bool removed;
+
+   if (!filename)
+      return;
+
+   w = utf8_to_wide(filename);
+   if (!w)
+      return;
+
+   if (GetFileAttributesExW(w, GetFileExInfoStandard, &ad))
+      fsize = ((uint64_t)ad.nFileSizeHigh << 32) | ad.nFileSizeLow;
+
+   removed = DeleteFileW(w) != 0;
+   free(w);
+
+   if (removed)
+      cache_size_sub(cache, fsize);
+}
+
+bool
+disk_cache_evict_lru_item(struct disk_cache *cache)
+{
+   struct cache_scan scan;
+   wchar_t *wpath;
+   bool evicted = false;
+
+   if (!cache->path)
+      return false;
+
+   memset(&scan, 0, sizeof(scan));
+   scan.want_lru = true;
+
+   wpath = utf8_to_wide(cache->path);
+   if (!wpath)
+      return false;
+
+   scan_dir(wpath, &scan);
+   free(wpath);
+
+   if (scan.lru_file) {
+      disk_cache_evict_item(cache, scan.lru_file);
+      free(scan.lru_file);
+      evicted = true;
+   }
+
+   return evicted;
+}
