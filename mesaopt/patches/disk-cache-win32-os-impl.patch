+/* ------------------------------ entry IO -------------------------------- */
+
+char *
+disk_cache_get_cache_filename(struct disk_cache *cache, const cache_key key)
+{
+   char hex[CACHE_KEY_SIZE * 2 + 1];
+   char subdir[3];
+   char name[CACHE_KEY_SIZE * 2 + 8];
+   char *dir, *res;
+
+   if (!cache->path)
+      return NULL;
+
+   key_to_hex(key, hex);
+   subdir[0] = hex[0];
+   subdir[1] = hex[1];
+   subdir[2] = '\0';
+
+   dir = path_join(cache->path, subdir);
+   if (!dir)
+      return NULL;
+
+   snprintf(name, sizeof(name), "%s.bin", hex);
+   res = path_join(dir, name);
+   free(dir);
+   return res;
+}
+
+static bool
+write_all(HANDLE h, const void *data, size_t size)
+{
+   const uint8_t *p = data;
+
+   while (size) {
+      DWORD chunk = size > 0x40000000u ? 0x40000000u : (DWORD)size;
+      DWORD written = 0;
+
+      if (!WriteFile(h, p, chunk, &written, NULL) || written == 0)
+         return false;
+
+      p += written;
+      size -= written;
+   }
+   return true;
+}
+
+void
+disk_cache_write_item_to_disk(struct disk_cache_put_job *dc_job, char *filename)
+{
+   struct disk_cache *cache = dc_job->cache;
+   const uint8_t *payload = dc_job->data;
+   size_t payload_size = dc_job->size;
+   uint32_t uncompressed_size = 0;
+   uint8_t *compressed = NULL;
+   struct cache_entry_file_data hdr;
+   char *slash;
+   wchar_t *w;
+
+   if (!cache->path || !filename || !cache->size)
+      return;
+
+   /* Make sure the two-part directory (<key[0:2]>) exists. */
+   slash = strrchr(filename, '/');
+   if (slash) {
+      char save = *slash;
+
+      *slash = '\0';
+      mkdir_recursive(filename);
+      *slash = save;
+   }
+
+   if (!cache->compression_disabled && dc_job->size > 64) {
+      size_t max_out = util_compress_max_compressed_len(dc_job->size);
+
+      compressed = malloc(max_out);
+      if (compressed) {
+         size_t csize = util_compress_deflate(dc_job->data, dc_job->size,
+                                             compressed, max_out);
+
+         if (csize > 0 && csize < dc_job->size) {
+            payload = compressed;
+            payload_size = csize;
+            uncompressed_size = (uint32_t)dc_job->size;
+         }
+      }
+   }
+
+   hdr.crc32 = util_hash_crc32(payload, payload_size);
+   hdr.uncompressed_size = uncompressed_size;
+
+   w = utf8_to_wide(filename);
+   if (w) {
+      HANDLE h = CreateFileW(w, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS,
+                             FILE_ATTRIBUTE_NORMAL, NULL);
+
+      free(w);
+
+      if (h != INVALID_HANDLE_VALUE) {
+         bool ok = write_all(h, &hdr, sizeof(hdr)) &&
+                   write_all(h, payload, payload_size);
+
+         CloseHandle(h);
+
+         if (ok)
+            p_atomic_add(&cache->size->value,
+                         (uint64_t)(sizeof(hdr) + payload_size));
+      }
+   }
+
+   free(compressed);
+}
+
+void *
+disk_cache_load_item(struct disk_cache *cache, char *filename, size_t *size)
+{
+   wchar_t *w;
+   HANDLE h;
+   LARGE_INTEGER file_size_ll;
+   size_t file_size, got = 0;
+   uint8_t *buf;
+   struct cache_entry_file_data hdr;
+   const uint8_t *payload;
+   size_t payload_size;
+   void *data;
+
+   (void)cache;
+
+   if (size)
+      *size = 0;
+   if (!filename)
+      return NULL;
+
+   w = utf8_to_wide(filename);
+   if (!w)
+      return NULL;
+
+   h = CreateFileW(w, GENERIC_READ,
+                   FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                   NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+   free(w);
+   if (h == INVALID_HANDLE_VALUE)
+      return NULL;
+
+   if (!GetFileSizeEx(h, &file_size_ll) ||
+       file_size_ll.QuadPart < (LONGLONG)sizeof(hdr)) {
+      CloseHandle(h);
+      return NULL;
+   }
+
+   file_size = (size_t)file_size_ll.QuadPart;
+   buf = malloc(file_size);
+   if (!buf) {
+      CloseHandle(h);
+      return NULL;
+   }
+
+   while (got < file_size) {
+      DWORD chunk = (file_size - got) > 0x40000000u ? 0x40000000u
+                                                    : (DWORD)(file_size - got);
+      DWORD n = 0;
+
+      if (!ReadFile(h, buf + got, chunk, &n, NULL) || n == 0)
+         break;
+      got += n;
+   }
+   CloseHandle(h);
+
+   if (got != file_size) {
+      free(buf);
+      return NULL;
+   }
+
+   memcpy(&hdr, buf, sizeof(hdr));
+   payload = buf + sizeof(hdr);
+   payload_size = file_size - sizeof(hdr);
+
+   if (util_hash_crc32(payload, payload_size) != hdr.crc32) {
+      free(buf);
+      return NULL;
+   }
+
+   if (hdr.uncompressed_size) {
+      data = malloc(hdr.uncompressed_size);
+      if (!data ||
+          !util_compress_inflate(payload, payload_size, data,
+                                 hdr.uncompressed_size)) {
+         free(data);
+         free(buf);
+         return NULL;
+      }
+      if (size)
+         *size = hdr.uncompressed_size;
+   } else {
+      data = malloc(payload_size ? payload_size : 1);
+      if (!data) {
+         free(buf);
+         return NULL;
+      }
+      memcpy(data, payload, payload_size);
+      if (size)
+         *size = payload_size;
+   }
+
+   free(buf);
+   return data;
+}
