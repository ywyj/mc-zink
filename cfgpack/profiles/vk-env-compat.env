# mc-zink — conservative profile for older Vulkan loaders/drivers
# 适用：Vulkan 1.3.x / 老 loader (如 1.3.30x)、relaxed present 不生效或抖动的机器
# 用法：拷到 <gameDir>/zinkgl.env；确认无 Vulkan 报错、GL 版本仍 4.6、帧率 ±2% 内
MESA_VK_WSI_PRESENT_MODE=fifo
MESA_SHADER_CACHE_DISABLE=false
MESA_GLSL_CACHE_DISABLE=false
# 排障时临时取消下一行注释（会明显掉帧，仅定位问题用）：
# ZINK_DEBUG=info
